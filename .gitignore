# =============================================================================
# AutoExecTool .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 环境变量 / 本地密钥（勿提交）----
.env
.env.*
!.env.example
*.pem

# ---- 打包产物 ----
dist/
build/
dist_build/
release/
*.spec

# ---- 运行时 data（现场用户数据，与绿色包策略一致：不入库、不随包覆盖）----
data/db/
data/logs/
data/tmp/
data/packages/
data/backups/
data/scripts/
data/config/keys/

# 业务编排（现场 YAML + 现场说明；只保留本目录总 README 入库）
data/config/playbooks/**
!data/config/playbooks/README.md

# 目录占位（若使用）
!data/packages/.gitkeep
!data/backups/.gitkeep
!data/tmp/.gitkeep
!data/scripts/.gitkeep

# ---- 日志 / 调试残留 ----
*.log

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
